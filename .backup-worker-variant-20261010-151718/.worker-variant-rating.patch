diff --git a/apps/mobile/test/product-facts.test.ts b/apps/mobile/test/product-facts.test.ts
new file mode 100644
index 0000000..125e944
--- /dev/null
+++ b/apps/mobile/test/product-facts.test.ts
@@ -0,0 +1,106 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import type { MobileProduct } from "../src/products-api";
+import {
+  availabilityOf,
+  dealLine,
+  productTags,
+  ratingText,
+} from "../src/product/product-facts";
+
+const product = (
+  extra: Partial<MobileProduct> = {},
+  availability?: string,
+): MobileProduct => ({
+  url: "https://shop.example/a",
+  title: "A",
+  images: [],
+  offers: [{ amountMinor: 100, currency: "CAD", availability }],
+  ...extra,
+});
+
+test("availability comes from the API, or from the stored schema.org name of an older cached product", () => {
+  assert.equal(
+    availabilityOf(product({ availability: "backorder" })),
+    "backorder",
+  );
+  assert.equal(
+    availabilityOf(product({ availability: null }, "InStock")),
+    null,
+  );
+  assert.equal(availabilityOf(product({}, "OutOfStock")), "out_of_stock");
+  assert.equal(availabilityOf(product()), null);
+});
+
+test("a card says nothing for an in-stock new product without deals, or when the store says nothing", () => {
+  assert.deepEqual(
+    productTags(product({ availability: "in_stock", condition: "new" })),
+    [],
+  );
+  assert.deepEqual(
+    productTags(product({ availability: null, condition: null, deals: [] })),
+    [],
+  );
+  assert.deepEqual(productTags(product({ availability: "limited" })), []);
+});
+
+test("a card shows stock problems, a non-new condition and the leading deal, at most two", () => {
+  assert.deepEqual(productTags(product({ availability: "out_of_stock" })), [
+    { label: "Out of stock" },
+  ]);
+  assert.deepEqual(
+    productTags(
+      product({
+        condition: "renewed",
+        deals: [
+          { type: "other", text: "Free delivery" },
+          { type: "coupon", text: "Save $5 with coupon" },
+          { type: "deal", text: "Lightning deal" },
+        ],
+      }),
+    ),
+    [{ label: "Renewed" }, { label: "Limited-time deal", tone: "accent" }],
+  );
+  assert.deepEqual(
+    productTags(
+      product({
+        availability: "preorder",
+        condition: "used",
+        deals: [{ type: "sale", text: "Rollback" }],
+      }),
+    ),
+    [{ label: "Pre-order" }, { label: "Used" }],
+  );
+  assert.deepEqual(
+    productTags(product({ deals: [{ type: "sale", text: "Rollback" }] })),
+    [{ label: "Rollback", tone: "accent" }],
+  );
+  assert.deepEqual(
+    productTags(product({ deals: [{ type: "other", text: "Free delivery" }] })),
+    [],
+  );
+});
+
+test("ratings read as stars out of 5, other scales say theirs", () => {
+  assert.equal(
+    ratingText({ value: 4.65, scale: 5, count: 1284 }),
+    "4.7 ★ (1,284)",
+  );
+  assert.equal(ratingText({ value: 8.4, scale: 10 }), "8.4/10");
+  assert.equal(ratingText(undefined), undefined);
+});
+
+test("a deal line keeps the store's words, its code and its end", () => {
+  assert.equal(
+    dealLine(
+      {
+        type: "coupon",
+        text: "Save $5 with coupon",
+        code: "FALL5",
+        validUntil: "2026-10-12T07:00:00Z",
+      },
+      () => "Oct 12",
+    ),
+    "Save $5 with coupon · Code FALL5 · Ends Oct 12",
+  );
+});
diff --git a/apps/worker/prisma/migrations/20261013000000_variant_rating_condition/migration.sql b/apps/worker/prisma/migrations/20261013000000_variant_rating_condition/migration.sql
new file mode 100644
index 0000000..e812aad
--- /dev/null
+++ b/apps/worker/prisma/migrations/20261013000000_variant_rating_condition/migration.sql
@@ -0,0 +1,28 @@
+-- Selected variant and rating of each tracked product (latest capture); condition and deals of each price
+-- observation, beside its availability. Existing rows keep their data: their variant, rating, condition and
+-- deals are unknown (null), except Shopify products, whose stored data already names the selected variant.
+ALTER TABLE "tracked_products"
+  ADD COLUMN "variant_id" TEXT,
+  ADD COLUMN "variant_label" TEXT,
+  ADD COLUMN "rating_value" DOUBLE PRECISION,
+  ADD COLUMN "rating_scale" DOUBLE PRECISION,
+  ADD COLUMN "rating_count" INTEGER,
+  ADD CONSTRAINT "tracked_products_rating_check" CHECK (
+    ("rating_value" IS NULL AND "rating_scale" IS NULL AND "rating_count" IS NULL)
+    OR ("rating_value" >= 0 AND "rating_scale" > 0 AND "rating_value" <= "rating_scale"
+        AND ("rating_count" IS NULL OR "rating_count" > 0))
+  );
+
+ALTER TABLE "price_observations"
+  ADD COLUMN "condition" TEXT,
+  ADD COLUMN "promotions" JSONB,
+  ADD CONSTRAINT "price_observations_condition_check" CHECK (
+    "condition" IS NULL OR "condition" IN ('new', 'used', 'renewed', 'open_box', 'damaged')
+  ),
+  ADD CONSTRAINT "price_observations_promotions_check" CHECK (
+    "promotions" IS NULL OR jsonb_typeof("promotions") = 'array'
+  );
+
+UPDATE "tracked_products"
+SET "variant_id" = "data"->>'variantId'
+WHERE "data" ? 'variantId' AND jsonb_typeof("data"->'variantId') = 'string';
