diff --git a/apps/mobile/src/browse/catalog-api.ts b/apps/mobile/src/browse/catalog-api.ts
new file mode 100644
index 0000000..f901fa4
--- /dev/null
+++ b/apps/mobile/src/browse/catalog-api.ts
@@ -0,0 +1,45 @@
+import { apiFailure } from "../errors";
+import { baseUrl } from "../api-base";
+import { productEntry } from "../product-data";
+import type { MobileProduct } from "../products-api";
+
+/** One page of the shared catalog (GET /catalog/products): pass `nextCursor` back as `cursor`; null is the end. */
+export type CatalogPage = { items: MobileProduct[]; nextCursor: string | null };
+
+/** The catalog is the same for everyone, so it needs no device token (like the store list). */
+export async function getCatalogPage({
+  cursor,
+  merchant,
+  limit,
+  signal,
+}: {
+  cursor?: string | null;
+  merchant?: string | null;
+  limit?: number;
+  signal?: AbortSignal;
+}): Promise<CatalogPage> {
+  const query = new URLSearchParams();
+  if (cursor) query.set("cursor", cursor);
+  if (merchant) query.set("merchant", merchant);
+  if (limit) query.set("limit", String(limit));
+  const search = query.size ? `?${query}` : "";
+  const response = await fetch(`${baseUrl}/catalog/products${search}`, {
+    signal,
+  });
+  if (!response.ok)
+    throw await apiFailure(
+      response,
+      "Could not load products. Please try again.",
+    );
+  const body = (await response.json()) as {
+    items?: { product?: unknown; history?: unknown }[];
+    nextCursor?: unknown;
+  };
+  return {
+    items: (body.items ?? []).flatMap((item) => {
+      const product = productEntry(item);
+      return product ? [product] : [];
+    }),
+    nextCursor: typeof body.nextCursor === "string" ? body.nextCursor : null,
+  };
+}
diff --git a/apps/mobile/src/browse/catalog-feed.ts b/apps/mobile/src/browse/catalog-feed.ts
new file mode 100644
index 0000000..b8ec66b
--- /dev/null
+++ b/apps/mobile/src/browse/catalog-feed.ts
@@ -0,0 +1,73 @@
+import type { MobileProduct } from "../products-api";
+import type { CatalogPage } from "./catalog-api";
+
+/**
+ * The Products section's paging state. `loading` covers both the first page and the next one (items tell them
+ * apart); `done` means the server said there is no next page.
+ */
+export type CatalogFeed = {
+  merchant: string | null;
+  items: readonly MobileProduct[];
+  cursor: string | null;
+  status: "loading" | "idle" | "error" | "done";
+  error: string;
+};
+
+export const startFeed = (merchant: string | null = null): CatalogFeed => ({
+  merchant,
+  items: [],
+  cursor: null,
+  status: "loading",
+  error: "",
+});
+
+/** Whether the shopper reaching the end should fetch another page. */
+export const canLoadMore = (feed: CatalogFeed) => feed.status === "idle";
+
+/**
+ * A page arrived: append it. A product already shown (it moved up between two pages because it was observed
+ * again) is not shown twice.
+ */
+export function appendPage(feed: CatalogFeed, page: CatalogPage): CatalogFeed {
+  const seen = new Set(feed.items.map((item) => item.url));
+  return {
+    ...feed,
+    items: [...feed.items, ...page.items.filter((item) => !seen.has(item.url))],
+    cursor: page.nextCursor,
+    status: page.nextCursor ? "idle" : "done",
+    error: "",
+  };
+}
+
+export const failPage = (feed: CatalogFeed, error: string): CatalogFeed => ({
+  ...feed,
+  status: "error",
+  error,
+});
+
+/** Retrying fetches the page that failed again; what is shown stays. */
+export const retryPage = (feed: CatalogFeed): CatalogFeed =>
+  feed.status === "error" ? { ...feed, status: "loading", error: "" } : feed;
+
+export const loadingNext = (feed: CatalogFeed): CatalogFeed =>
+  canLoadMore(feed) ? { ...feed, status: "loading" } : feed;
+
+/** The section hides only when the catalog (or the chosen store's part of it) is known to be empty. */
+export const feedVisible = (feed: CatalogFeed) =>
+  !(feed.status === "done" && feed.items.length === 0 && !feed.merchant);
+
+/** Pixels from the bottom at which the next page starts loading, about two rows of cards ahead. */
+export const NEAR_END = 600;
+
+/** Whether a scroll position is close enough to the end of the content to fetch the next page. */
+export function nearEnd(
+  {
+    offset,
+    viewport,
+    content,
+  }: { offset: number; viewport: number; content: number },
+  threshold = NEAR_END,
+) {
+  "worklet";
+  return content > 0 && offset + viewport >= content - threshold;
+}
diff --git a/apps/mobile/src/browse/use-catalog-feed.ts b/apps/mobile/src/browse/use-catalog-feed.ts
new file mode 100644
index 0000000..940a305
--- /dev/null
+++ b/apps/mobile/src/browse/use-catalog-feed.ts
@@ -0,0 +1,80 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { userMessage } from "../errors";
+import { getCatalogPage } from "./catalog-api";
+import {
+  appendPage,
+  canLoadMore,
+  failPage,
+  loadingNext,
+  retryPage,
+  startFeed,
+  type CatalogFeed,
+} from "./catalog-feed";
+
+/**
+ * The Products section's pages: the first loads on mount, `more` fetches the next one (ignored while one is
+ * loading or after the last), `filter` restarts at one store, `reload` restarts for pull-to-refresh.
+ */
+export function useCatalogFeed() {
+  const [feed, setFeed] = useState<CatalogFeed>(() => startFeed());
+  // The latest state for callbacks, and the request in flight (a new start aborts it).
+  const current = useRef(feed);
+  current.current = feed;
+  const inFlight = useRef<AbortController | null>(null);
+  const fetchPage = useCallback(async (from: CatalogFeed) => {
+    inFlight.current?.abort();
+    const abort = new AbortController();
+    inFlight.current = abort;
+    try {
+      const page = await getCatalogPage({
+        cursor: from.cursor,
+        merchant: from.merchant,
+        signal: abort.signal,
+      });
+      if (!abort.signal.aborted) setFeed(appendPage(from, page));
+    } catch (error) {
+      if (!abort.signal.aborted)
+        setFeed(
+          failPage(
+            from,
+            userMessage(error, "Could not load products. Please try again."),
+          ),
+        );
+    } finally {
+      if (inFlight.current === abort) inFlight.current = null;
+    }
+  }, []);
+  const start = useCallback(
+    (merchant: string | null) => {
+      const next = startFeed(merchant);
+      setFeed(next);
+      return fetchPage(next);
+    },
+    [fetchPage],
+  );
+  useEffect(() => {
+    void start(null);
+    return () => inFlight.current?.abort();
+  }, [start]);
+  const more = useCallback(() => {
+    const feed = current.current;
+    if (!canLoadMore(feed) || inFlight.current) return;
+    const next = loadingNext(feed);
+    setFeed(next);
+    void fetchPage(next);
+  }, [fetchPage]);
+  const retry = useCallback(() => {
+    const next = retryPage(current.current);
+    if (next === current.current) return;
+    setFeed(next);
+    void fetchPage(next);
+  }, [fetchPage]);
+  const filter = useCallback(
+    (merchant: string | null) => {
+      if (merchant !== current.current.merchant) void start(merchant);
+    },
+    [start],
+  );
+  const reload = useCallback(() => start(current.current.merchant), [start]);
+  return { feed, more, retry, filter, reload };
+}
diff --git a/apps/mobile/test/catalog-feed.test.ts b/apps/mobile/test/catalog-feed.test.ts
new file mode 100644
index 0000000..bff5ad2
--- /dev/null
+++ b/apps/mobile/test/catalog-feed.test.ts
@@ -0,0 +1,99 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import type { MobileProduct } from "../src/products-api";
+import {
+  appendPage,
+  canLoadMore,
+  failPage,
+  feedVisible,
+  loadingNext,
+  nearEnd,
+  retryPage,
+  startFeed,
+} from "../src/browse/catalog-feed";
+
+const product = (n: number): MobileProduct => ({
+  url: `https://www.bestbuy.ca/p/${n}`,
+  title: `Product ${n}`,
+  images: [],
+  offers: [{ amountMinor: 1000 + n, currency: "CAD" }],
+  history: [],
+});
+
+test("pages append in order until the server has no next cursor", () => {
+  let feed = startFeed();
+  assert.equal(feed.status, "loading");
+  assert.equal(canLoadMore(feed), false);
+  feed = appendPage(feed, {
+    items: [product(1), product(2)],
+    nextCursor: "c1",
+  });
+  assert.equal(feed.status, "idle");
+  assert.equal(canLoadMore(feed), true);
+  feed = loadingNext(feed);
+  assert.equal(feed.status, "loading");
+  // Asking again while a page loads changes nothing.
+  assert.equal(loadingNext(feed), feed);
+  feed = appendPage(feed, { items: [product(3)], nextCursor: null });
+  assert.deepEqual(
+    feed.items.map((p) => p.title),
+    ["Product 1", "Product 2", "Product 3"],
+  );
+  assert.equal(feed.status, "done");
+  assert.equal(canLoadMore(feed), false);
+  assert.equal(loadingNext(feed), feed);
+});
+
+test("a product that moved up between two pages is not shown twice", () => {
+  const feed = appendPage(
+    appendPage(startFeed(), {
+      items: [product(1), product(2)],
+      nextCursor: "c",
+    }),
+    { items: [product(2), product(3)], nextCursor: "d" },
+  );
+  assert.deepEqual(
+    feed.items.map((p) => p.url),
+    [product(1), product(2), product(3)].map((p) => p.url),
+  );
+  assert.equal(feed.cursor, "d");
+});
+
+test("a failed page keeps what is shown and retries the same cursor", () => {
+  const shown = appendPage(startFeed(), {
+    items: [product(1)],
+    nextCursor: "c1",
+  });
+  const failed = failPage(loadingNext(shown), "Could not load products.");
+  assert.equal(failed.status, "error");
+  assert.equal(failed.items.length, 1);
+  assert.equal(canLoadMore(failed), false);
+  const retrying = retryPage(failed);
+  assert.equal(retrying.status, "loading");
+  assert.equal(retrying.cursor, "c1");
+  assert.equal(retrying.error, "");
+  assert.equal(retryPage(shown), shown);
+});
+
+test("the section hides only for a known-empty catalog, not while loading, failing or filtered", () => {
+  assert.equal(feedVisible(startFeed()), true);
+  assert.equal(feedVisible(failPage(startFeed(), "x")), true);
+  assert.equal(
+    feedVisible(appendPage(startFeed(), { items: [], nextCursor: null })),
+    false,
+  );
+  // A store with nothing yet keeps the section (and its chips) so the shopper can switch back.
+  assert.equal(
+    feedVisible(
+      appendPage(startFeed("bestbuy-ca"), { items: [], nextCursor: null }),
+    ),
+    true,
+  );
+});
+
+test("the next page starts loading within about two rows of the end", () => {
+  assert.equal(nearEnd({ offset: 0, viewport: 800, content: 4000 }), false);
+  assert.equal(nearEnd({ offset: 2600, viewport: 800, content: 4000 }), true);
+  assert.equal(nearEnd({ offset: 3200, viewport: 800, content: 4000 }), true);
+  assert.equal(nearEnd({ offset: 0, viewport: 800, content: 0 }), false);
+});
