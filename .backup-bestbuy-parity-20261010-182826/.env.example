NODE_ENV=development
BULLMQ_PREFIX=bull
DATABASE_URL=postgres://morydeals:local-morydeals@127.0.0.1:55432/morydeals
REDIS_URL=redis://127.0.0.1:56379
CRAWL_ARCHIVE_DIR=.local/crawl-archive
CRAWL_CONCURRENCY=2
CRAWL_MAX_BUDGET_MS=120000
CRAWL_MAX_BYTES=5242880
CRAWL_DOMAIN_INTERVAL_MS=2000

# Optional remote Camoufox Docker service (otherwise use local Camoufox)
CAMOUFOX_WS_ENDPOINT=
# Host worker -> Docker browser: bind 0.0.0.0, advertise host.docker.internal
CRAWL_PROXY_BIND_HOST=127.0.0.1
CRAWL_PROXY_ADVERTISED_HOST=127.0.0.1
# Stagehand model key is deployment-only, never part of task context
STAGEHAND_API_KEY=

# Optional hosted browser providers; endpoints and keys never enter task context
BROWSERLESS_WS_ENDPOINT=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# JSON deployment file referencing endpoint/header environment variable names
CRAWL_BROWSER_CONFIG=

# Ordinary browser resource slots, reused across worker jobs
CRAWL_BROWSER_POOL_SIZE=2
CRAWL_BROWSER_IDLE_MS=30000
# Optional proxy profiles; referenced environment values are JSON arrays of HTTP(S) proxy URLs
CRAWL_PROXY_CONFIG=
# Example: docs/crawler/proxies.example.json references CA_PROXY_URLS
CA_PROXY_URLS=

# LLM extraction provider. Invoked only when context.parsing.strategy is llm.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# SiliconFlow credentials stay in deployment configuration, never task context or audit.
# Parses pages without a store parser: anthropic | siliconflow | ollama (needs that provider's key)
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=zai-org/GLM-5.3-Flash

# DataImpulse: docs/crawler/dataimpulse.md (credentials injected locally)
DATAIMPULSE_CA_ROTATING_URLS=
DATAIMPULSE_CA_STICKY_URLS=

# Local mobile API
API_HOST=127.0.0.1
API_PORT=3000
API_PROXY_PROFILE=

# API admission policy for stores not listed in api.merchants
API_ALLOW_OTHER_MERCHANTS=true
# Protects merchant logo upload/complete endpoints. Keep this out of client bundles.
# MERCHANT_ADMIN_TOKEN=

# API object storage (independent of worker audit ZIPs)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIRECTORY=.local/storage
# Set a stable random secret of 32+ characters; required for production local storage.
# STORAGE_SIGNING_SECRET=
# Use the Mac's LAN address when testing on a physical phone (for example,
# http://10.0.0.147:3000). Loopback only works inside the Mac/simulator.
PUBLIC_API_URL=http://127.0.0.1:3000
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# Exact API-selected direct hosts; all other hosts use API_PROXY_PROFILE.
API_DIRECT_HOSTS=

# Shared writable volume for API + worker WebView snapshots (relative to repo root).
CAPTURE_SNAPSHOT_DIRECTORY=.local/capture-snapshots

# Keepa API for Amazon price history backfill (server only)
KEEPA_API_KEY=
# Tokens Keepa refills per minute on your plan; the backfill spends at most this each minute.
KEEPA_TOKENS_PER_MINUTE=20

# TypeSafe Jev page-type classifier for automatic capture (server only)
TYPESAFE_API_KEY=
# Classifier provider for automatic visits (jev); a page is captured when P(product) reaches the threshold.
PAGE_CLASSIFIER=jev
PAGE_PRODUCT_THRESHOLD=0.7
PAGE_CLASSIFIER_MARKDOWN_LIMIT=8000
