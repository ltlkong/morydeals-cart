+/**
+ * The desktop gallery of the selected variant, in page order with the main image first: the image block's
+ * `'colorImages': { 'initial': A.$.parseJSON('[…]') }` (each image's hiRes, else large), else the twister's
+ * colorImages for its landingAsinColor, else the #altImages thumbnails at SL1500. Videos are never included.
+ */
+function desktopGallery(root: HtmlNode): string[] {
+  const scripts = all(root, 'script').map(content);
+  const parsed = (raw: string): GalleryEntry[] => {
+    try {
+      const value: unknown = JSON.parse(raw);
+      return Array.isArray(value) ? (value as GalleryEntry[]) : [];
+    } catch {
+      return [];
+    }
+  };
+  for (const code of scripts) {
+    const initial =
+      /'colorImages'\s*:\s*\{\s*'initial'\s*:\s*A\.\$\.parseJSON\('((?:[^'\\]|\\.)*)'\)/.exec(
+        code,
+      )?.[1];
+    if (!initial) continue;
+    const images = parsed(initial.replace(/\\'/g, "'")).map(galleryUrl).filter(Boolean);
+    if (images.length) return images as string[];
+  }
+  for (const code of scripts) {
+    const landing = /"landingAsinColor"\s*:\s*"((?:[^"\\]|\\.)*)"/.exec(code)?.[1];
+    const start = code.indexOf('"colorImages":{');
+    if (!landing || start < 0) continue;
+    const key = `${JSON.stringify(JSON.parse(`"${landing}"`))}:[`;
+    const at = code.indexOf(key, start);
+    if (at < 0) continue;
+    // The variant's array runs to its matching bracket.
+    let depth = 0;
+    let end = at + key.length - 1;
