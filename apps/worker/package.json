{
  "name": "@morydeals/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "worker": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/unit/**/*.test.ts\"",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "browser:install": "camoufox-js fetch && playwright install chromium firefox webkit",
    "test:browser": "tsx --test test/browser/*.test.ts",
    "build": "rimraf dist && prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "lint": "eslint src test prisma.config.ts",
    "format": "prettier --write src test *.json *.mjs prisma.config.ts README.md",
    "format:check": "prettier --check src test *.json *.mjs prisma.config.ts README.md",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@browserbasehq/stagehand": "3.7.3",
    "@crawlee/basic": "^3.18.2",
    "@crawlee/browser-pool": "^3.18.2",
    "@crawlee/playwright": "^3.18.2",
    "@crawlee/stagehand": "^3.18.2",
    "@morydeals/capture-contracts": "*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/driver-adapter-utils": "^7.10.0",
    "acorn": "^8.19.0",
    "bullmq": "^6.3.11",
    "camoufox-js": "0.12.1",
    "cheerio": "^1.2.0",
    "commander": "^12.1.0",
    "css-select": "^5.2.2",
    "currency-codes": "^2.2.0",
    "domhandler": "^5.0.3",
    "domutils": "^3.2.2",
    "dotenv": "^18.0.6",
    "htmlparser2": "^10.1.0",
    "https-proxy-agent": "^7.0.6",
    "impit": "0.14.5",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "ollama": "^0.6.4",
    "openai": "7.31.0",
    "p-queue": "^9.3.3",
    "p-retry": "^8.0.1",
    "playwright": "1.62.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tough-cookie": "6.0.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.1.2",
    "@types/node": "^26.6.4",
    "@types/turndown": "^5.0.6",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.1"
  }
}
