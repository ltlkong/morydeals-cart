{
  "name": "@morydeals/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go --port 8091",
    "ios": "expo start --go --ios --port 8091",
    "web": "expo start --web --port 8091",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "ios:device": "expo run:ios --device --port 8092",
    "start:dev": "expo start --dev-client --port 8092"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@ghostery/adblocker": "^2.20.1",
    "@morydeals/capture-contracts": "^0.1.0",
    "@morydeals/ui": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-clipboard": "~57.0.2",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.53.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "^0.10.1",
    "tldts": "^7.4.18"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
